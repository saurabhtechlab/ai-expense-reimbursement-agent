# ==============================================================================
# ReimburseAI — Environment Configuration Template
# Copy this file to .env and configure as needed:
#   cp .env.example .env
# ==============================================================================

# (Optional) OpenAI API Key for Multimodal Document Understanding (gpt-4o-mini).
# If omitted or left empty, ReimburseAI will automatically use its built-in
# offline heuristic OCR parser with zero loss of core functionality.
OPENAI_API_KEY=

# Server Network Configuration (Defaults: HOST=0.0.0.0, PORT=8000)
HOST=0.0.0.0
PORT=8000

# (Optional) Custom Database Path (Defaults to backend/reimbursements.db)
# DATABASE_PATH=backend/reimbursements.db
